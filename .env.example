# Copy to .env and fill in. .env is gitignored; this file is not.

# TMDB — posters, backdrops, summaries, genres, and the IMDb id for each title.
# Free personal key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# IGDB — video games: portrait box art, summaries, genres, platforms, developer.
# Free, but it authenticates through Twitch rather than a plain key:
#   1. https://dev.twitch.tv/console  →  Register Your Application
#   2. Name it anything, OAuth Redirect URL http://localhost, Category "Application Integration"
#   3. Copy the Client ID, then Generate a Client Secret
# The backend exchanges these for a bearer token itself and caches it under data/.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Pexels — ambient/chrome imagery ONLY (shelf headers, empty states, the
# backdrop behind the carousel). Never title artwork; stock photos cannot
# supply real key art. https://www.pexels.com/api/
PEXELS_API_KEY=

# Where the SQLite file lives. Created automatically on first startup.
MEDIA_LIST_DB=data/media-list.db

# Bind address. 7799 is this project's reserved port (see ../PROJECT_PORTS.md).
MEDIA_LIST_HOST=127.0.0.1
MEDIA_LIST_PORT=7799
