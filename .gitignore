# ── the owner's list is private; the app is public ───────────────────────────────
# The database, the artwork cached for HIS titles, and any CSV export all
# reveal what he watches. None of it belongs in a public repo.
data/
*.db
*.db-journal
# WAL sidecars hold committed rows that have not been checkpointed yet — they are
# as revealing as the database itself, and only the data/ rule was covering them.
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# ANY csv, not just ones named like an export. The old rule was `media-list-export*.csv`,
# which a file called `my-list.csv`, `backup.csv` or `pre-t16-export.csv` walks straight past —
# and an export carries his titles AND his `why` notes and reviews ("Satoshi Kon, apparently the
# one Aronofsky lifted from"). Found during T-16, when a build agent's own export fixture slipped
# the glob on its NAME alone. No CSV is tracked in this repo and none ever should be by accident;
# a deliberate fixture needs `git add -f`, which is exactly the moment to think twice.
*.csv

# ── secrets ────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── build + tooling ────────────────────────────────────────────────────────
node_modules/
dist/
.venv/
venv/
__pycache__/
*.py[cod]
*.log
.cache/
.DS_Store

# factory ledger and generated day pages stay local (public repo, owner's request 2026-09-05)
.autodev/
kb/days/

# T-13 test tooling (mirrors the runtime rules above)
.pytest_cache/
.coverage
htmlcov/

# T-14: Playwright's own run artifacts (traces, the HTML report) — regenerated by every run
test-results/
playwright-report/
blob-report/
